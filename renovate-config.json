{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "github",
  "autodiscover": true,
  "autodiscoverFilter": ["my-my-platform/*"],
  "onboarding": false,
  "requireConfig": "optional",
  "extends": ["config:recommended"],
  "enabledManagers": ["maven"],
  "packageRules": [
    {
      "matchDatasources": ["maven"],
      "registryUrls": ["http://nexus:8081/repository/maven-public/"]
    },
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["com.mymyplatform:platform-bom"],
      "enabled": true,
      "groupName": "platform-bom",
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
